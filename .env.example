# ============================================================
# Production environment template
# Copy this to your host's environment (Railway variables, etc.),
# then generate a real APP_KEY and set your real site URL/email.
# never commit your real .env — it must be gitignored.
# ============================================================

APP_NAME="Yamagata Oni"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://YOUR-DOMAIN-HERE

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# Database (Railway provides these)*
DB_CONNECTION=mysql
DB_HOST=YOUR_DB_HOST
DB_PORT=3306
DB_DATABASE=YOUR_DB_NAME
DB_USERNAME=YOUR_DB_USER
DB_PASSWORD=YOUR_DB_PASSWORD

# Sessions & cache use the database — robust across restarts/instances
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

# Mail — set to your real SMTP provider (Mailgun, SendGrid, etc.)
# For local testing only use MAIL_MAILER=log
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=YOUR_SMTP_USER
MAIL_PASSWORD=YOUR_SMTP_PASSWORD
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="orders@yamagataoni.com"
MAIL_FROM_NAME="Yamagata Oni"

CONTACT_EMAIL="orders@yamagataoni.com"
TELEGRAM_URL="YOUR_TELEGRAM_URL"
WHATSAPP_URL="YOUR_WHATSAPP_URL"

GA_TRACKING_ID=
GTM_ID=